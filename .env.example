# F-TECH-Student-Hub Environment Configuration Example
# Copy this file to .env and configure your production credentials.
# NEVER commit production passwords, tokens, or JWT secrets to source control.

PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_unique_admin_password
DATABASE_PATH=database/student_hub.db
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,doc,docx,ppt,pptx,zip,png,jpg,jpeg
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
API_KEY=replace_with_your_backend_api_key
